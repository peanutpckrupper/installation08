+        uint64_t began = now_ns();
+        long copied;
+
+        snprintf(bundle, sizeof(bundle), "%s/bundle", runtime_roots[i]);
+        mkdir(root, 0777);
+        copied = copy_missing(bundle, root, 0);
+        PS5LOG_LOG("PW_WINE64 bundle from=%s copied=%ld ms=%llu", bundle, copied,
+                   (unsigned long long)((now_ns() - began) / 1000000u));
+        if (copied >= 0) return;
+    }
+}
+#endif
