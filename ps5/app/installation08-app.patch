 /* ---- library ------------------------------------------------------------ */
 
+#ifdef PW_FIXED_PROFILE
+/* Copy from into to, file by file, keeping what to already has. Returns the
+ * number of files copied, or -1 when from cannot be read. */
+static long copy_missing(const char *from, const char *to, int depth)
+{
+    DIR *dir;
+    struct dirent *entry;
+    long copied = 0;
+
+    if (depth > 24 || !(dir = opendir(from))) return -1;
+    mkdir(to, 0777);
+    while ((entry = readdir(dir))) {
+        char source[1024], target[1024];
+        struct stat info;
+
+        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+        if (snprintf(source, sizeof(source), "%s/%s", from, entry->d_name) >= (int)sizeof(source) ||
+            snprintf(target, sizeof(target), "%s/%s", to, entry->d_name) >= (int)sizeof(target) ||
+            stat(source, &info))
+            continue;
+        if (S_ISDIR(info.st_mode)) {
+            long below = copy_missing(source, target, depth + 1);
+            if (below > 0) copied += below;
+            continue;
+        }
+        if (!S_ISREG(info.st_mode) || !access(target, F_OK)) continue;
+        {
+            char part[1040];
+            int in = open(source, O_RDONLY), out;
+            static char buffer[1 << 20];
+            ssize_t got = 0;
+
+            if (in < 0) continue;
+            snprintf(part, sizeof(part), "%s.part", target);
+            out = open(part, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+            if (out < 0) { close(in); continue; }
+            while ((got = read(in, buffer, sizeof(buffer))) > 0)
+                if (write(out, buffer, (size_t)got) != got) { got = -1; break; }
+            close(in);
+            if (close(out) || got < 0 || rename(part, target)) { unlink(part); continue; }
+            copied++;
+        }
+    }
+    closedir(dir);
+    return copied;
+}
+
+/* The first start, or one after a game file was deleted: put the bundled
+ * library in place. Only missing files are copied, so settings, saves and
+ * an updated exe stay. */
+static void install_bundle(const char *root)
+{
