 1 file changed, 46 insertions(+), 2 deletions(-)

diff --git a/native/wine64_main.c b/native/wine64_main.c
index 2134bca..887749b 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -650,6 +650,51 @@ static void restart_title(const PwWineApp *app, uint32_t cycle, const char *reas
 
 /* Wine ends the process with exit() when its last program ends: go back to
  * the launcher. */
+#ifdef PW_FIXED_PROFILE
+/* Closing the title from the game. Ending the process with exit() shows the
+ * console's CE-108255-1 "an error has occurred" (seen on the console), so the
+ * title asks the system to close it instead. Which request works is being
+ * found out: <root>/exit_method holds the digits to try in order (default
+ * 123), each logged first:
+ *   1  sceSystemServiceLoadExec("exit")
+ *   2  sceSystemServiceKillApp on the running app's id
+ *   3  sceLncUtilKillApp on it
+ *   4  _exit(0) at once (what happened before, without the exit handlers) */
+int sceSystemServiceGetAppIdOfRunningBigApp(void);
+int sceSystemServiceKillApp(int app_id, int how, int reason, int core_dump);
+int sceLncUtilKillApp(int app_id);
+
+static void close_to_home(void)
+{
+    char path[PW_WINE_LIBRARY_PATH + 16], order[16] = "123";
+    FILE *file;
+
+    snprintf(path, sizeof(path), "%s/exit_method", library_root);
+    if ((file = fopen(path, "r"))) {
+        if (!fgets(order, sizeof(order), file)) snprintf(order, sizeof(order), "123");
+        fclose(file);
+    }
+    for (const char *step = order; *step >= '1' && *step <= '9'; step++) {
+        int rc = 0, app = sceSystemServiceGetAppIdOfRunningBigApp();
+
+        PS5LOG_LOG("PW_WINE64 close method=%c app=0x%x", *step, (unsigned)app);
+        pw_diagnostics_close("wine64-close");
+        switch (*step) {
+        case '1': rc = sceSystemServiceLoadExec("exit", NULL); break;
+        case '2': rc = sceSystemServiceKillApp(app, -1, 0, 0); break;
+        case '3': rc = sceLncUtilKillApp(app); break;
+        case '4': _exit(0);
+        default: continue;
+        }
+        /* A kill takes a moment to arrive. */
